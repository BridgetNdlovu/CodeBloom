# Uncommon CodeBloom — Frontend environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local or secrets to source control.

# ASP.NET Core API base URL. Local development default: http://localhost:5202
# On Vercel, configure this as a Project Environment Variable and redeploy.
# Use the publicly reachable HTTPS URL of the deployed backend, with no trailing slash.
VITE_API_BASE_URL=http://localhost:5202

# Optional: enable debug logging of API calls
VITE_DEBUG_API=false
